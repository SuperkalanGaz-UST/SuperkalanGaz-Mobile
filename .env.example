# Superkalan Gaz — Customer and Delivery Rider mobile environment.
# Copy to `.env` and fill in. Values are read via app.json `extra` / expo-constants;
# EXPO_PUBLIC_* vars are also inlined into the JS bundle at build time.

# Base URL of the NestJS API (superkalan-crm-api). The client appends `/api`.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth — used for Customer authentication/password recovery and
# Delivery Rider invitation identity verification. Domain data still goes only
# through the NestJS API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Production HTTPS host shared by the invitation landing page and native App
# Links / Universal Links, for example links.your-domain.ph (hostname only).
# Leave empty for local custom-scheme development. This is not a secret.
APP_LINK_HOST=
