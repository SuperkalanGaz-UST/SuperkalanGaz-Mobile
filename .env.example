# Superkalan Gaz — mobile (customer app) environment.
# Copy to `.env` and fill in. Values are read via app.json `extra` / expo-constants;
# EXPO_PUBLIC_* vars are also inlined into the JS bundle at build time.

# Base URL of the NestJS API (superkalan-crm-api). The client appends `/api`.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth (managed Postgres project) — used for sign-in only; all data
# access goes through the API, never the Supabase data SDK (see AGENTS.md §4).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
