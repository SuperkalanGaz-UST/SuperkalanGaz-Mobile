{
  "expo": {
    "name": "Superkalan Gaz",
    "slug": "superkalan-crm-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "superkalan",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ph.superkalan.crm"
    },
    "android": {
      "package": "ph.superkalan.crm"
    },
    "extra": {
      "apiUrl": "http://localhost:3001"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Superkalan Gaz to use your location to pin a delivery address."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Superkalan Gaz to select a delivery proof photo.",
          "cameraPermission": "Allow Superkalan Gaz to take a delivery proof photo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
